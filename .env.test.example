# =============================================================================
# DjangoAir ERP — Automated Test Environment (.env.test)
# =============================================================================
APP_ENV=test
DJANGO_SETTINGS_MODULE=config.settings.test
DJANGO_SECRET_KEY=djangoair-test-only-secret-key-at-least-32-bytes-rfc7518
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
LOG_LEVEL=WARNING

# Isolated Test PostgreSQL
POSTGRES_DB=djangoair_test
POSTGRES_USER=djangoair_test
POSTGRES_PASSWORD=djangoair_test_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (ephemeral)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_EVENTS_CHANNEL=djangoair:test:events

# In-memory test email backend
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DEFAULT_FROM_EMAIL=tickets@test.djangoair.local

# Webhooks
WEBHOOK_DEFAULT_SECRET=djangoair-webhook-test-secret
WEBHOOK_MOCK_URL=http://webhook_mock:5002/mock-webhook/events
