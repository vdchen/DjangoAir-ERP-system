# =============================================================================
# DjangoAir ERP — Development Environment (.env.dev)
# =============================================================================
APP_ENV=dev
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=djangoair-dev-only-secret-key-at-least-32-bytes-rfc7518
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend
LOG_LEVEL=DEBUG

# PostgreSQL
POSTGRES_DB=djangoair_dev
POSTGRES_USER=djangoair
POSTGRES_PASSWORD=djangoair_dev_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_EVENTS_CHANNEL=djangoair:events

# SMTP Email (Mailpit local capture)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=tickets@dev.djangoair.local

# Webhooks
WEBHOOK_DEFAULT_SECRET=djangoair-webhook-dev-secret
WEBHOOK_MOCK_URL=http://webhook_mock:5002/mock-webhook/events

# Runtime
GUNICORN_WORKERS=2
NGINX_PORT=8080

# Google OAuth2 (dev mock enabled locally so Google login works without Cloud Console keys)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_DEV_MOCK_ENABLED=1
