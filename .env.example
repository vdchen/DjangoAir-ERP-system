# Django Environment: config.settings.dev | config.settings.test | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=djangoair-dev-secret-key-change-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend

# PostgreSQL
POSTGRES_DB=djangoair
POSTGRES_USER=djangoair
POSTGRES_PASSWORD=djangoair_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_EVENTS_CHANNEL=djangoair:events

# SMTP Email (Mailpit in Docker)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=tickets@djangoair.local

# Webhook Integration
WEBHOOK_DEFAULT_SECRET=djangoair-webhook-dev-secret
WEBHOOK_MOCK_URL=http://webhook_mock:5002/mock-webhook/events
