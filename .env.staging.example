# =============================================================================
# DjangoAir ERP — Staging Environment (.env.staging)
# =============================================================================
APP_ENV=staging
DJANGO_SETTINGS_MODULE=config.settings.staging
DJANGO_SECRET_KEY=CHANGE_ME_STRONG_STAGING_SECRET_KEY_MIN_50_CHARS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=staging.djangoair.example.com,localhost,nginx,backend
CORS_ALLOWED_ORIGINS=https://staging.djangoair.example.com
CSRF_TRUSTED_ORIGINS=https://staging.djangoair.example.com
SECURE_SSL_REDIRECT=1
SECURE_COOKIES=1
SECURE_HSTS_SECONDS=3600
LOG_LEVEL=INFO

# Container Registry
GHCR_REPO=vdchen/djangoair-erp-system
IMAGE_TAG=staging

# PostgreSQL
POSTGRES_DB=djangoair_staging
POSTGRES_USER=djangoair_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Redis & Celery
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_EVENTS_CHANNEL=djangoair:staging:events

# SMTP Email (Staging sandbox SMTP relay)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.staging.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_SMTP_USER
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@staging.djangoair.example.com

# Webhooks
WEBHOOK_DEFAULT_SECRET=CHANGE_ME_STAGING_WEBHOOK_SECRET
WEBHOOK_MOCK_URL=http://webhook_mock:5002/mock-webhook/events

# Runtime
GUNICORN_WORKERS=3
NGINX_PORT=8080

# Google OAuth2 (dev mock strictly disabled in staging)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_DEV_MOCK_ENABLED=0

# Payment Gateway Provider ("emulated" or "stripe" with sk_test_... keys)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# OpenTelemetry OTLP Distributed Tracing
OTEL_TRACES_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=djangoair-backend-staging
