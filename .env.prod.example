# =============================================================================
# DjangoAir ERP — Production Environment (.env.prod / main branch)
# =============================================================================
APP_ENV=prod
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=CHANGE_ME_STRONG_PRODUCTION_SECRET_KEY_MIN_64_CHARS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=djangoair.example.com,api.djangoair.example.com
CORS_ALLOWED_ORIGINS=https://djangoair.example.com
CSRF_TRUSTED_ORIGINS=https://djangoair.example.com
SECURE_SSL_REDIRECT=1
SECURE_COOKIES=1
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# Immutable Container Registry Release Tag (never use latest in prod)
GHCR_REPO=vdchen/djangoair-erp-system
IMAGE_TAG=v1.0.0

# PostgreSQL (managed RDS/Cloud SQL recommended in production)
POSTGRES_DB=djangoair_prod
POSTGRES_USER=djangoair_prod
POSTGRES_PASSWORD=CHANGE_ME_PROD_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=120

# Redis & Celery
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_EVENTS_CHANNEL=djangoair:prod:events

# SMTP Email (Production transactional provider e.g. SES/Postmark/SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.prod.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_PROD_SMTP_USER
EMAIL_HOST_PASSWORD=CHANGE_ME_PROD_SMTP_PASSWORD
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=tickets@djangoair.example.com

# Webhooks
WEBHOOK_DEFAULT_SECRET=CHANGE_ME_PROD_WEBHOOK_SECRET
WEBHOOK_TIMEOUT_SECONDS=5

# Runtime
GUNICORN_WORKERS=4
NGINX_PORT=80

# Google OAuth2 (dev mock strictly disabled in production)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_DEV_MOCK_ENABLED=0

# Payment Gateway Provider ("stripe" recommended in production, "emulated" for sandbox)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# OpenTelemetry OTLP Distributed Tracing
OTEL_TRACES_ENABLED=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=djangoair-backend

# AI Disruption & Rebooking Copilot ("openai" | "gemini" | "deterministic")
AI_COPILOT_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
